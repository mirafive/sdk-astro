{
  "name": "@mirafive/sdk-astro",
  "version": "1.0.0",
  "description": "MIRA FIVE SDK for Astro",
  "keywords": [
    "analytics",
    "astro",
    "astro-integration",
    "cookieless",
    "gdpr",
    "mirafive",
    "privacy",
    "withastro"
  ],
  "homepage": "https://mirafive.io",
  "bugs": {
    "email": "support@mirafive.io"
  },
  "license": "MIT",
  "author": "MIRA FIVE <support@mirafive.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirafive/sdk-astro.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "size": "size-limit",
    "example": "cd example && npm install --no-audit --no-fund && npm run build && npm run build:full",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && publint --strict && attw --pack --profile esm-only && size-limit",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@mirafive/sdk-browser": "^1.0.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26.6.5",
    "astro": "^7.4.2",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsdown": "0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@mirafive/sdk-browser": "^1.0.0",
    "astro": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.4"
}
