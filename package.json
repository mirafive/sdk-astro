{
  "name": "@mirafive/sdk-astro",
  "version": "0.5.0",
  "description": "MIRA FIVE for Astro: privacy-first analytics bundled into the site's own JavaScript, and server-rendered feature flags.",
  "keywords": [
    "ab-testing",
    "analytics",
    "astro",
    "astro-integration",
    "cookieless",
    "feature-flags",
    "gdpr",
    "mirafive",
    "privacy",
    "withastro"
  ],
  "homepage": "https://mirafive.io",
  "bugs": {
    "email": "support@mirafive.io"
  },
  "license": "MIT",
  "author": "MIRA FIVE <support@mirafive.io>",
  "repository": "github:mirafive/sdk-astro",
  "files": [
    "components",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./server": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "size": "size-limit",
    "example": "cd example && npm install --no-audit --no-fund && npm run build && npm run build:full",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && publint --strict && attw --pack --profile esm-only && size-limit",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@mirafive/sdk-browser": "file:../sdk-browser",
    "@mirafive/sdk-server": "file:../sdk-server",
    "@size-limit/preset-small-lib": "^14.0.1",
    "@types/node": "^26.6.3",
    "astro": "^7.3.5",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "publint": "^0.3.24",
    "size-limit": "^14.0.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@mirafive/sdk-browser": "^0.5.0",
    "@mirafive/sdk-server": "^0.5.0",
    "astro": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@mirafive/sdk-server": {
      "optional": true
    }
  },
  "overrides": {
    "@mirafive/sdk-browser": "file:../sdk-browser"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.2"
}
