---
import { ClientRouter } from "astro:transitions"

interface Props {
  title: string
}

const { title } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <nav><a href="/">Home</a> · <a href="/pricing">Pricing</a> · <a href="/flags">Flags (SSR)</a></nav>
    <slot />
    <p>
      <button type="button" data-consent="yes">Accept analytics</button>
      <button type="button" data-consent="no">Decline</button>
    </p>
    <script>
      import { mirafive } from "@mirafive/sdk-astro/client"

      // The site's own consent banner. In consentless mode consent() only warns in development.
      document.addEventListener("click", (event) => {
        const answer = (event.target as Element).closest("[data-consent]")?.getAttribute("data-consent")

        if (answer) {
          mirafive("consent", answer === "yes")
        }
      })
    </script>
  </body>
</html>
